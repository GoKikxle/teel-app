VITE_SUPABASE_URL=https://your-project.supabase.co
# Either format works with createClient — Supabase's newer publishable
# key (sb_publishable_...) or a legacy anon JWT (eyJ...).
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — used by api/signin.ts to check/record waitlist approval and
# to send the magic link, bypassing RLS on the `waitlist` table. Never
# prefix this with VITE_ (that would ship it to the client bundle). Not
# read by Vite, so this alone doesn't need to be in .env.local unless
# you're running api/signin.ts locally. Either format works here too —
# Supabase's newer secret key (sb_secret_...) or a legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
