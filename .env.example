VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by api/signin.ts to check/record waitlist approval and
# to send the magic link, bypassing RLS on the `waitlist` table. Never
# prefix this with VITE_ (that would ship it to the client bundle). Not
# read by Vite, so this alone doesn't need to be in .env.local unless
# you're running api/signin.ts locally.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
